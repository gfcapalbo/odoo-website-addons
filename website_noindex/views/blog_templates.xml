<odoo>
    <template id="blog_post_noindex" inherit_id="website_blog.blog_post_complete">
        <xpath expr="//section" position="before">
            <meta t-if="
                (website and website.no_index)
                or
                (blog_post and blog_post.no_index)
            "
            name="robots"
            content="noindex, nofollow"/>
        </xpath>
    </template>
</odoo>
